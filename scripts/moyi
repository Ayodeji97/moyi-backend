#!/usr/bin/env bash
# moyi — the daily loop from a terminal.
#
# M3 is "the loop runs live for a week between two real people via the HTTP
# API" (doc 15 §4), and there is no app yet. This is what those two people
# type: sign in once, then `moyi write "..."` and `moyi today` each day, and
# `moyi streak` when they want to know how it is going. Bruno
# (tools/bruno) is the same requests for somebody who would sooner click.
#
#   MOYI_API=http://localhost:8080/api/v1   where the server is (the default)
#   MOYI_PROFILE=ada                         whose session; one file per profile
#   MOYI_INSECURE=1                          allow plain http to a host that is not this machine
#
#   moyi register <email> <display name> [locale]   the language you are shown prompts in, e.g. pt-PT (en if not given)
#   moyi verify <token>                      the token in the confirmation email (getmoyi.app/verify shows it)
#   moyi resend-verification <email>         a new confirmation email, when the first has expired (they last 24 hours)
#   moyi login <email>
#   moyi forgot-password <email>             emails a reset link, if the address has an account
#   moyi reset-password <token>              the token in that email; asks for the new password twice
#   moyi bond new <name> <timezone>          prints the invite code to send your partner
#   moyi bond join <code>
#   moyi bond use <bondId>                   which bond the commands below mean
#   moyi bond leave [--withdraw-entries | --keep-entries]
#                                            end the bond in use. Your entries are KEPT unless you say
#                                            --withdraw-entries, which erases them for both of you, for good
#   moyi bond block (--withdraw-entries | --keep-entries)
#                                            end it, and the two of you cannot be paired again. One of the
#                                            two flags is required: --withdraw-entries erases your entries
#                                            for both of you, for good; --keep-entries leaves them readable.
#                                            It may be repeated, to withdraw what an earlier one kept
#   moyi write [--prompt] "<text>"           or: moyi write [--prompt] -   (the text from stdin). With --prompt, the
#                                            entry answers today's prompt (moyi today shows it); without, it answers none
#   moyi today
#   moyi edit <entryId> "<text>"             until your partner has written
#   moyi delete <entryId>
#   moyi streak
#   moyi days [--limit N] [--until YYYY-MM-DD] [--favourites] [--cursor <nextCursor>]
#                                            the archive, newest day first: one page of it. --until starts
#                                            at that date or the nearest earlier one; --favourites keeps to
#                                            the days holding an entry you have marked; --cursor asks for
#                                            the page after one whose nextCursor you were given
#   moyi day <YYYY-MM-DD>                    one day of the archive
#   moyi search "<words>" [--limit N] [--cursor <nextCursor>]
#                                            or: moyi search - [--limit N] [--cursor …]   (the words from stdin).
#                                            Days on which one entry you can read holds every word; case and accents
#                                            do not matter, whole words only
#   moyi on-this-day                         this date in earlier years, in the bond in use; nothing once it has ended
#   moyi milestones                          the milestones reached at 7, 30, 100 and 365 days you both wrote,
#                                            each with its date, and the next; nothing next once it has ended
#   moyi favourite <entryId>                 mark a revealed entry, yours or your partner's. The mark is
#                                            yours alone: your partner is never shown it
#   moyi unfavourite <entryId>
#   moyi react <entryId> <type>              leave a reaction on your partner's revealed entry, in place
#                                            of any you had left: HEART, THANK_YOU, SMILE, MOVED or ME_TOO.
#                                            Your partner IS shown it, on that entry. Not on your own
#                                            entry, and not once the bond has ended
#   moyi unreact <entryId>                   take it back; also after the bond has ended
#   moyi report <entryId> <reason> [-]       report your partner's entry, with its photo and voice note, to a
#                                            person: NON_CONSENSUAL, MINOR_SEXUAL_CONTENT, VIOLENCE_OR_SELF_HARM,
#                                            HARASSMENT or OTHER. With -, what the reviewer should know is read
#                                            from stdin (at most 500 characters). From then its photo and voice
#                                            note are held back from you until a person decides. Your partner is
#                                            not told
#   moyi notifications [<kind>=on|off …]     which kinds of push you want in the bond in use: with nothing,
#                                            shows them; with e.g. onThisDay=on reminder=off, sets those
#                                            and leaves the rest. The kinds are the server's: reminder,
#                                            partnerJoined, reveal, milestone, onThisDay, proposal
#   moyi whoami
#
# And one command for the operator, not a member (spec Phase 4 §4 D4, ADR-0051), which talks to the
# database, not the API, until the Phase 5 console exists. MOYI_OPERATOR names who is acting; every
# look and every decision is recorded under it in media_moderation_log. MOYI_OPS_PSQL is how psql is
# reached (on the server, the default: docker exec -i moyi-postgres psql -U moyi -d moyi):
#
#   moyi media quarantine list               what moderation held back: verdict, id, kind, status, reason,
#                                            attached, when; a BLOCKED row is marked DO NOT VIEW
#   moyi media quarantine release <mediaId> "<note>"
#                                            lets it reach the partner after all. Never a BLOCKED one
#                                            (child sexual abuse material): that is refused, and recorded
#   moyi media quarantine delete <mediaId> "<note>"
#                                            deletes it and its objects. For a BLOCKED one, only after the
#                                            report ops/moderation/takedown.md requires; the note carries
#                                            its reference
#   moyi media quarantine hold <mediaId> "<note>"
#                                            a member reported it: hold it back from the partner (§3)
#   moyi media quarantine block <mediaId> "<note>"
#                                            a member reported child sexual abuse material: block it, held
#                                            as evidence, never released (§3, then §2)
#
# And the queue of members' reports (FR-100, ADR-0053), the same way, recorded in entry_report_log:
#
#   moyi reports list                        the open reports, priority first: id, reason, entry, how many
#                                            photos and voice notes each holds back, whether it has a
#                                            detail, when. A MINOR_SEXUAL_CONTENT row is marked DO NOT VIEW
#   moyi reports show <reportId>             one report: the reporter's detail and what it holds back
#                                            (the look is recorded)
#   moyi reports dismiss <reportId> "<note>" not what was reported: its photo and voice note are given back
#                                            as they were, unless another report or moderation holds them
#   moyi reports reclassify <reportId> <reason> "<note>"
#                                            the reporter chose the wrong reason, and their detail shows it:
#                                            change it, recorded with the old and new reasons and why. The
#                                            only way a MINOR_SEXUAL_CONTENT report is upheld by anything
#                                            but a block
#   moyi reports uphold <reportId> delete|block "<note>"
#                                            what was reported: delete what it holds back, or block it as
#                                            child sexual abuse material (held as evidence; runbook §2)
#
# The session (two tokens and the bond in use) is kept in
# ~/.config/moyi/<profile>.json, readable by you alone. The password is asked
# for and never stored. An access token lasts fifteen minutes; when one has
# lapsed the refresh token is used once, as the app will.
#
# Nothing secret is ever a command-line argument of a process this starts: on
# a shared machine anyone can read those with `ps`. The password, the tokens
# and what you write reach curl and python through files only you can read
# and through pipes. (What you type after `moyi write` is in your own shell's
# argument list and history; `moyi write -` reads it from stdin instead. An
# invite code, a verification token and a reset token are typed as
# arguments, and a code is part of the URL, which curl is given in a file:
# all three are single-use.)
#
# It prints what the server sent. It decides nothing: every rule is the
# server's, and this script is not a second copy of any of them.
set -euo pipefail

API="${MOYI_API:-http://localhost:8080/api/v1}"
PROFILE="${MOYI_PROFILE:-default}"
DIR="${XDG_CONFIG_HOME:-$HOME/.config}/moyi"
SESSION="$DIR/$PROFILE.json"

die() { echo "moyi: $*" >&2; exit 1; }
[[ "$PROFILE" =~ ^[A-Za-z0-9_-]+$ ]] || die "MOYI_PROFILE must be letters, digits, - or _"
command -v curl >/dev/null || die "curl is required"
command -v python3 >/dev/null || die "python3 is required"

# The password and the tokens travel to MOYI_API. Over plain http anybody on
# the path reads them, so that is for this machine only unless you say so.
LOCAL='^http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?(/|$)'
if [[ ! "$API" =~ ^https://[^/[:space:]]+ ]] && [[ ! "$API" =~ $LOCAL ]]; then
  [ "${MOYI_INSECURE:-}" = 1 ] && [[ "$API" =~ ^http://[^/[:space:]]+ ]] ||
    die "MOYI_API must be https://… (or http://localhost). Set MOYI_INSECURE=1 to send your password over plain http."
fi

UUID='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
# These become part of a URL. Anything that is not what the server issues is refused here, not sent.
need_uuid() { [[ "$2" =~ $UUID ]] || die "$1 is not an id: it should look like 019a0c1e-7b2a-7c3d-8e4f-5a6b7c8d9e0f"; }
need_code() { [[ "$1" =~ ^[A-Za-z0-9_-]{4,64}$ ]] || die "that is not an invite code"; }
# The shape only, so that it is safe in a URL. Whether it is a date, and one of yours, is the server's to say.
need_date() { [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "that is not a date: it should look like 2026-10-09"; }

# Request bodies and headers are written here: a directory only you can read, gone when this exits.
TMP="$(umask 077; mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# session_get <key> — a value from the session file, or empty.
session_get() {
  [ -f "$SESSION" ] || return 0
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2]) or "")' "$SESSION" "$1"
}

# pairs <key> <value> … | python — hands values to python on stdin, NUL-separated. `printf` is the shell's own:
# nothing here is an argument of a process.
pairs() { printf '%s\0' "$@"; }

# session_set <key> <value> … — merges pairs into the session file, mode 600.
session_set() {
  mkdir -p "$DIR"; chmod 700 "$DIR"
  ( umask 077
    pairs "$@" | python3 -c '
import json, os, sys
path = sys.argv[1]
a = sys.stdin.buffer.read().decode().split("\0")[:-1]
data = json.load(open(path)) if os.path.exists(path) else {}
data.update(dict(zip(a[0::2], a[1::2])))
tmp = path + ".tmp"
with open(tmp, "w") as out:
    json.dump(data, out)
os.replace(tmp, path)' "$SESSION"
  )
  chmod 600 "$SESSION"
}

# json_of <key> <value> … — a JSON object of strings, every value escaped by a JSON library and not by this shell.
json_of() {
  pairs "$@" | python3 -c '
import json, sys
a = sys.stdin.buffer.read().decode().split("\0")[:-1]
print(json.dumps(dict(zip(a[0::2], a[1::2]))))'
}

# with_json <object as JSON> <key> <value> … — the same, merged over an object that needs more than strings.
with_json() {
  local base="$1"; shift
  pairs "$@" | python3 -c '
import json, sys
a = sys.stdin.buffer.read().decode().split("\0")[:-1]
print(json.dumps({**json.loads(sys.argv[1]), **dict(zip(a[0::2], a[1::2]))}))' "$base"
}

# field <dotted.path> — reads JSON on stdin; prints the value or nothing.
field() {
  python3 -c '
import json, sys
node = json.load(sys.stdin)
for part in sys.argv[1].split("."):
    node = node.get(part) if isinstance(node, dict) else None
print("" if node is None else node)' "$1"
}

# As the server sent it, indented; what two people wrote is shown as written, not as \u escapes.
# A body that is not JSON is printed as it came.
pretty() {
  python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    print(json.dumps(json.loads(raw), indent=4, ensure_ascii=False))
except ValueError:
    sys.stdout.write(raw)'
}

# call <method> <path> [json body] — leaves the status in STATUS and the body in BODY.
# Sends the access token unless ANONYMOUS=1 (signing in, refreshing: a lapsed token there is only noise).
call() {
  local method="$1" path="$2" body="${3:-}" token=""
  [ "${ANONYMOUS:-}" = 1 ] || token="$(session_get accessToken)"
  # It becomes a header line. Anything that is not a token's alphabet is not sent.
  [[ -z "$token" || "$token" =~ ^[A-Za-z0-9._~+/=-]+$ ]] || die "the saved session is damaged: moyi login <email>"
  rm -f "$TMP/out" "$TMP/body"
  {
    printf 'Accept: application/json\n'
    [ -z "$token" ] || printf 'Authorization: Bearer %s\n' "$token"
    [ -z "$body" ] || printf 'Content-Type: application/json\n'
    # A write carries a key (doc 06 §1). A new one each time this sends: nothing here resends a write that may have landed.
    if [ "$method" = POST ] && [[ "$path" == */entries || "$path" == */report ]]; then
      printf 'Idempotency-Key: %s\n' "$(python3 -c 'import uuid; print(uuid.uuid4())')"
    fi
  } > "$TMP/headers"
  local -a args=(--globoff -s -o "$TMP/out" -w '%{http_code}' -X "$method" -H "@$TMP/headers")
  if [ -n "$body" ]; then printf '%s' "$body" > "$TMP/body"; args+=(--data-binary "@$TMP/body"); fi
  # The URL in a file, not in argv: a search's words and an invite code are in it, and argv is
  # readable by every process on the machine. Paths here are built from checked ids and from
  # python's percent-encoding, so no quote or backslash reaches the file.
  printf 'url = "%s"\n' "$API$path" > "$TMP/url"
  STATUS="$(curl "${args[@]}" -K "$TMP/url")" || die "could not reach $API"
  BODY="$(cat "$TMP/out" 2>/dev/null || true)"
}

# keep_tokens [key value …] — the two tokens out of BODY and into the session, with anything else given.
keep_tokens() {
  # With where they came from: a session is for one server, and its tokens are sent to no other.
  session_set api "$API" accessToken "$(printf '%s' "$BODY" | field accessToken)" \
              refreshToken "$(printf '%s' "$BODY" | field refreshToken)" "$@"
}

signed_in() {
  [ -n "$(session_get accessToken)" ] || die "not signed in: moyi login <email>"
  local home; home="$(session_get api)"
  [ -z "$home" ] || [ "$home" = "$API" ] || die "this session is for $home, not $API: moyi login <email>, or use another MOYI_PROFILE"
}

# authed <method> <path> [body] — call, and once more after a refresh if the access token had lapsed.
authed() {
  signed_in
  call "$@"
  if [ "$STATUS" = 401 ] && refresh; then call "$@"; fi
}

refresh() {
  local token; token="$(session_get refreshToken)"
  [ -n "$token" ] || return 1
  ANONYMOUS=1 call POST /auth/refresh "$(json_of refreshToken "$token")"
  [ "$STATUS" = 200 ] || return 1
  keep_tokens
}

# show [expected status …] — prints the body; fails with the server's own words on any other status.
show() {
  for ok in "$@"; do
    if [ "$STATUS" = "$ok" ]; then [ -n "$BODY" ] && printf '%s\n' "$BODY" | pretty; return 0; fi
  done
  echo "moyi: the server answered $STATUS" >&2
  printf '%s\n' "$BODY" | pretty >&2
  exit 1
}

bond() {
  local id; id="$(session_get bondId)"
  [ -n "$id" ] || die "no bond in use: moyi bond new …, moyi bond join <code>, or moyi bond use <bondId>"
  need_uuid "the bond in use" "$id"
  printf '%s' "$id"
}

ask_password() { local p; IFS= read -r -s -p "password: " p; echo >&2; printf '%s' "$p"; }

# A password being chosen is asked for twice: the prompt shows nothing, so a
# slip would otherwise become a password nobody knows. Whether it is a good
# password is the server's to say.
ask_new_password() {
  local p q
  IFS= read -r -s -p "new password: " p; echo >&2
  IFS= read -r -s -p "the same again: " q; echo >&2
  [ "$p" = "$q" ] || die "the two passwords differ; nothing was sent"
  printf '%s' "$p"
}

# The operator's way in (`moyi media quarantine`, `moyi reports`): not a member's, and the one that talks to the
# database rather than the API. There is no admin console before Phase 5.
ops_init() {
  OPERATOR="${MOYI_OPERATOR:-}"
  [[ "$OPERATOR" =~ ^[A-Za-z0-9._@-]{1,64}$ ]] ||
    die "set MOYI_OPERATOR to your name (letters, digits, . _ @ -): every look at the queue and every decision is recorded under it"
  # How to reach psql: on the server, the Postgres accessory (the default); elsewhere, any psql command line,
  # e.g. MOYI_OPS_PSQL="psql -h localhost -p 55449 -U moyi -d moyi" with the password in PGPASSWORD or ~/.pgpass.
  read -r -a OPS_PSQL <<< "${MOYI_OPS_PSQL:-docker exec -i moyi-postgres psql -U moyi -d moyi}"
}

# ops_sql <sql> [name=value …] — runs one statement; values reach it as psql variables (:'name'), quoted by psql,
# never spliced into the SQL here. Every rule (what may be released, what deleting publishes, what a report holds)
# is the database's: the functions of V36, V38 and V39. This script only names which one to run.
ops_sql() {
  local statement="$1"; shift
  local -a vars=()
  for pair in "$@"; do vars+=(-v "$pair"); done
  printf '%s\n' "$statement" | "${OPS_PSQL[@]}" -X -q -At -F $'\t' -v ON_ERROR_STOP=1 "${vars[@]}"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  register)
    [ $# -eq 2 ] || [ $# -eq 3 ] || die "usage: moyi register <email> <display name> [locale]"
    password="$(ask_new_password)"
    ANONYMOUS=1 call POST /auth/register \
      "$(with_json '{"acceptedTermsVersion":"2026-09-01","over18":true}' email "$1" password "$password" displayName "$2" locale "${3:-en}")"
    [ "$STATUS" = 201 ] || show 201
    echo "Registered. Now: moyi verify <the token in the email>, then moyi login $1"
    ;;
  verify)
    [ $# -eq 1 ] || die "usage: moyi verify <token>"
    ANONYMOUS=1 call POST /auth/verify-email "$(json_of token "$1")"; show 200
    echo "Verified."
    ;;
  resend-verification)
    [ $# -eq 1 ] || die "usage: moyi resend-verification <email>"
    ANONYMOUS=1 call POST /auth/resend-verification "$(json_of email "$1")"; show 202
    echo "If $1 has an account still to be confirmed, a new email is on its way. Then: moyi verify <the token in it>"
    ;;
  login)
    [ $# -eq 1 ] || die "usage: moyi login <email>"
    password="$(ask_password)"
    ANONYMOUS=1 call POST /auth/login \
      "$(with_json '{"device":{"platform":"ANDROID","appVersion":"moyi-cli","osVersion":"cli"}}' email "$1" password "$password")"
    # A session that was there stays as it was until this one has succeeded.
    [ "$STATUS" = 200 ] || show 200
    keep_tokens email "$1"
    echo "Signed in as $1 (profile $PROFILE)."
    ;;
  forgot-password)
    [ $# -eq 1 ] || die "usage: moyi forgot-password <email>"
    ANONYMOUS=1 call POST /auth/forgot-password "$(json_of email "$1")"; show 202
    echo "If $1 has an account, a reset email is on its way. Then: moyi reset-password <the token in it>"
    ;;
  reset-password)
    [ $# -eq 1 ] || die "usage: moyi reset-password <token>"
    password="$(ask_new_password)"
    ANONYMOUS=1 call POST /auth/reset-password "$(json_of token "$1" password "$password")"; show 200
    echo "Password changed. Now: moyi login <email>"
    ;;
  whoami)
    authed GET /me; show 200
    echo "bond in use: $(session_get bondId)"
    ;;
  bond)
    sub="${1:-}"; shift || true
    case "$sub" in
      new)
        [ $# -eq 2 ] || die "usage: moyi bond new <name> <timezone, e.g. Africa/Lagos>"
        authed POST /bonds "$(json_of name "$1" type COUPLE anchorTimezone "$2")"
        [ "$STATUS" = 201 ] || show 201
        session_set bondId "$(printf '%s' "$BODY" | field id)"
        echo "Bond created and in use. Send your partner this code: $(printf '%s' "$BODY" | field invite.code)"
        ;;
      join)
        [ $# -eq 1 ] || die "usage: moyi bond join <code>"
        need_code "$1"
        authed POST "/invites/$1/accept"
        [ "$STATUS" = 200 ] || show 200
        session_set bondId "$(printf '%s' "$BODY" | field id)"
        echo "Joined. This bond is now in use."
        ;;
      use)
        [ $# -eq 1 ] || die "usage: moyi bond use <bondId>"
        need_uuid "$1" "$1"
        session_set bondId "$1"; echo "Using bond $1."
        ;;
      leave|block)
        if [ "$sub" = leave ]; then
          usage="usage: moyi bond leave [--withdraw-entries | --keep-entries]   (with neither, your entries are kept)"
        else
          usage="usage: moyi bond block (--withdraw-entries | --keep-entries)   (say which: withdrawing erases your entries for both of you, for good)"
        fi
        [ $# -le 1 ] || die "$usage"
        # The flag is always sent, never left to the server. A block's used to erase, and the server now refuses
        # one without it (ADR-0035 question 1); a command that asked nothing would only fail. So that one asks
        # which, and a bare leave says "keep" in so many words; what is printed afterwards is then what was
        # asked for, whatever the server's defaults become.
        case "$sub ${1:-}" in
          *" --withdraw-entries") withdraw=true ;;
          *" --keep-entries")     withdraw=false ;;
          "leave ")               withdraw=false ;;
          *) die "$usage" ;;
        esac
        signed_in; BOND="$(bond)"
        authed POST "/bonds/$BOND/$sub" "{\"withdrawEntries\":$withdraw}"; show 204
        if [ "$withdraw" = true ]; then echo "Bond ended. Your entries were withdrawn."; else echo "Bond ended. Your entries were kept."; fi
        [ "$sub" = leave ] || echo "You will not be paired with its other member again."
        ;;
      list|"") authed GET /bonds; show 200 ;;
      *) die "unknown: moyi bond $sub" ;;
    esac
    ;;
  write)
    prompt=0; [ "${1:-}" = --prompt ] && { prompt=1; shift; }
    [ $# -eq 1 ] || die 'usage: moyi write [--prompt] "<text>"   or: moyi write [--prompt] -   (the text from stdin)'
    signed_in; BOND="$(bond)"
    if [ "$1" = - ]; then text="$(cat)"; else text="$1"; fi
    if [ "$prompt" = 1 ]; then
      authed GET "/bonds/$BOND/today"; [ "$STATUS" = 200 ] || show 200
      prompt_id="$(printf '%s' "$BODY" | field prompt.id)"
      [ -n "$prompt_id" ] || die "there is no prompt today; write without --prompt"
      authed POST "/bonds/$BOND/entries" "$(json_of text "$text" promptId "$prompt_id")"
    else
      authed POST "/bonds/$BOND/entries" "$(json_of text "$text")"
    fi
    show 201
    ;;
  today)  signed_in; BOND="$(bond)"; authed GET "/bonds/$BOND/today";  show 200 ;;
  streak) signed_in; BOND="$(bond)"; authed GET "/bonds/$BOND/streak"; show 200 ;;
  days)
    usage="usage: moyi days [--limit N] [--until YYYY-MM-DD] [--favourites] [--cursor <nextCursor>]"
    query=""
    # Each value is checked for what may sit in a URL and no further: 0, 51 and 007 are digits, and are sent,
    # and it is the server that refuses them.
    while [ $# -gt 0 ]; do
      case "$1" in
        --limit)      [ $# -ge 2 ] && [[ "$2" =~ ^[0-9]{1,9}$ ]] || die "$usage"; query="$query&limit=$2"; shift 2 ;;
        --until)      [ $# -ge 2 ] || die "$usage"; need_date "$2"; query="$query&until=$2"; shift 2 ;;
        --cursor)     [ $# -ge 2 ] && [[ "$2" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || die "$usage"; query="$query&cursor=$2"; shift 2 ;;
        --favourites) query="$query&favourites=true"; shift ;;
        *) die "$usage" ;;
      esac
    done
    signed_in; BOND="$(bond)"
    authed GET "/bonds/$BOND/days${query:+?${query#&}}"; show 200
    # One page, as the server cut it. Nothing here follows the cursor: it is printed, to be given back.
    next="$(printf '%s' "$BODY" | field nextCursor)"
    [ -z "$next" ] || echo "There may be earlier days. For the next page, the same command with: --cursor $next"
    ;;
  day)
    [ $# -eq 1 ] || die "usage: moyi day <YYYY-MM-DD>"
    need_date "$1"
    signed_in; BOND="$(bond)"; authed GET "/bonds/$BOND/days/$1"; show 200
    ;;
  search)
    usage='usage: moyi search "<words>" [--limit N] [--cursor <nextCursor>]   or: moyi search - [--limit N] [--cursor <nextCursor>]'
    [ $# -ge 1 ] || die "$usage"
    if [ "$1" = - ]; then words="$(cat)"; else words="$1"; fi
    shift
    query=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --limit)  [ $# -ge 2 ] && [[ "$2" =~ ^[0-9]{1,9}$ ]] || die "$usage"; query="$query&limit=$2"; shift 2 ;;
        --cursor) [ $# -ge 2 ] && [[ "$2" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || die "$usage"; query="$query&cursor=$2"; shift 2 ;;
        *) die "$usage" ;;
      esac
    done
    signed_in; BOND="$(bond)"
    # Encoded by python from stdin, every character but the unreserved ones: what was searched for is never argv.
    q="$(pairs "$words" | python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.stdin.buffer.read().decode().split("\0")[0], safe=""))')"
    authed GET "/bonds/$BOND/search?q=$q$query"; show 200
    next="$(printf '%s' "$BODY" | field nextCursor)"
    [ -z "$next" ] || echo "There may be more. For the next page, the same command with: --cursor $next"
    ;;
  on-this-day)
    [ $# -eq 0 ] || die "usage: moyi on-this-day"
    signed_in; BOND="$(bond)"; authed GET "/bonds/$BOND/on-this-day"; show 200
    ;;
  milestones)
    [ $# -eq 0 ] || die "usage: moyi milestones"
    signed_in; BOND="$(bond)"; authed GET "/bonds/$BOND/milestones"; show 200
    ;;
  favourite)
    [ $# -eq 1 ] || die "usage: moyi favourite <entryId>"
    need_uuid "$1" "$1"
    authed PUT "/entries/$1/favourite"; show 204
    echo "Marked."
    ;;
  unfavourite)
    [ $# -eq 1 ] || die "usage: moyi unfavourite <entryId>"
    need_uuid "$1" "$1"
    authed DELETE "/entries/$1/favourite"; show 204
    echo "Unmarked."
    ;;
  react)
    [ $# -eq 2 ] || die "usage: moyi react <entryId> <type>   (HEART, THANK_YOU, SMILE, MOVED or ME_TOO)"
    need_uuid "$1" "$1"
    # The type is sent as it was typed. Which names are reactions is the server's to say, and it says 422.
    authed PUT "/entries/$1/reaction" "$(json_of type "$2")"; show 204
    echo "Reacted. Your partner is shown it."
    ;;
  unreact)
    [ $# -eq 1 ] || die "usage: moyi unreact <entryId>"
    need_uuid "$1" "$1"
    authed DELETE "/entries/$1/reaction"; show 204
    echo "Taken back."
    ;;
  report)
    usage="usage: moyi report <entryId> <reason> [-]   (NON_CONSENSUAL, MINOR_SEXUAL_CONTENT, VIOLENCE_OR_SELF_HARM, HARASSMENT or OTHER; - reads a detail from stdin)"
    [ $# -eq 2 ] || { [ $# -eq 3 ] && [ "$3" = - ]; } || die "$usage"
    need_uuid "$1" "$1"
    # The reason is sent as it was typed: which names are reasons is the server's to say, and it says 422. The detail
    # is read from stdin, never an argument: it is what you tell a person about your partner.
    if [ $# -eq 3 ]; then
      detail="$(cat)"
      authed POST "/entries/$1/report" "$(json_of reason "$2" detail "$detail")"
    else
      authed POST "/entries/$1/report" "$(json_of reason "$2")"
    fi
    show 201
    echo "Reported. A person will read it. Your partner is not told. Its photo and voice note are held back from you until then."
    ;;
  reports)
    # The queue of members' reports (FR-100, ADR-0053): the operator's, through the database, as the quarantine is.
    usage="usage: moyi reports list | show <reportId> | dismiss <reportId> \"<note>\" | reclassify <reportId> <reason> \"<note>\" | uphold <reportId> delete|block \"<note>\""
    action="${1:-}"; shift || true
    ops_init
    case "$action" in
      list)
        [ $# -eq 0 ] || die "$usage"
        out="$(ops_sql "SELECT * FROM entry_report_list(:'actor');" "actor=$OPERATOR")" || die "the database refused (see above)"
        if [ -z "$out" ]; then echo "No report is open."; exit 0; fi
        # The function's columns after the first, in its order. A priority row (sexual content involving a minor) is
        # never viewed (ops/moderation/takedown.md §2), and says so; it comes first.
        printf 'reportId\treason\tentryId\theld\tdetail\treceivedAt\n'
        printf '%s\n' "$out" | awk -F '\t' 'BEGIN { OFS = "\t" } { p = $1; $1 = ""; sub(/^\t/, ""); if (p == "t") print $0, "DO NOT VIEW — runbook §2"; else print $0 }'
        ;;
      show)
        [ $# -eq 1 ] || die "$usage"
        need_uuid reportId "$1"
        # The detail as a JSON string, so that what the reporter typed (a tab, a new line) cannot break a row here.
        out="$(ops_sql "SELECT report_id, reason, status, entry_id, bond_id, received_at, coalesce(to_json(detail)::text, '-'),
                               media_id, media_kind, media_status, media_verdict
                        FROM entry_report_read(:'report'::uuid, :'actor');" "report=$1" "actor=$OPERATOR")" ||
          die "the database refused (see above)"
        [ -n "$out" ] || die "that id names no report"
        printf '%s\n' "$out" | awk -F '\t' '
          NR == 1 {
            print "report:     " $1; print "reason:     " $2 ($2 == "MINOR_SEXUAL_CONTENT" ? "   DO NOT VIEW its media — runbook §2" : "")
            print "status:     " $3; print "entry:      " $4; print "bond:       " $5; print "received:   " $6
            print "detail:     " $7; print "holds back:"
          }
          $8 != "" { held++; print "  " $9 "\t" $8 "\t" $10 "\t" $11 }
          END { if (held == 0) print "  nothing" }'
        ;;
      dismiss)
        [ $# -eq 2 ] || die "$usage"
        need_uuid reportId "$1"
        [ -n "$2" ] && [ "${#2}" -le 400 ] || die "a note is required (at most 400 characters): why it is not what was reported"
        result="$(ops_sql "SELECT entry_report_dismiss(:'report'::uuid, :'actor', :'note');" "report=$1" "actor=$OPERATOR" "note=$2")" ||
          die "the database refused (see above)"
        case "$result" in
          DISMISSED) echo "Dismissed: what it held back is shown again, unless another report or moderation holds it." ;;
          NOT_OPEN)  die "that id names no open report (never made, or already decided)" ;;
          *)         die "unexpected answer from the database: $result" ;;
        esac
        ;;
      reclassify)
        [ $# -eq 3 ] || die "$usage"
        need_uuid reportId "$1"
        [[ "$2" =~ ^[A-Z_]{1,40}$ ]] || die "$usage"
        [ -n "$3" ] && [ "${#3}" -le 400 ] || die "a note is required (at most 400 characters): what in the report shows the reason was wrong"
        # Which names are reasons is the database's CHECK; a name that is not one is refused there.
        result="$(ops_sql "SELECT entry_report_reclassify(:'report'::uuid, :'reason', :'actor', :'note');" "report=$1" "reason=$2" "actor=$OPERATOR" "note=$3")" ||
          die "the database refused (see above)"
        case "$result" in
          RECLASSIFIED) echo "Reclassified as $2, and recorded. Decide it as runbook §3 says for that reason." ;;
          SAME_REASON)  die "it already has that reason" ;;
          NOT_OPEN)     die "that id names no open report (never made, or already decided)" ;;
          *)            die "unexpected answer from the database: $result" ;;
        esac
        ;;
      uphold)
        [ $# -eq 3 ] || die "$usage"
        need_uuid reportId "$1"
        case "$2" in delete) takedown=DELETE ;; block) takedown=BLOCK ;; *) die "$usage" ;; esac
        [ -n "$3" ] && [ "${#3}" -le 400 ] || die "a note is required (at most 400 characters): what was found, and for a block, the date"
        out="$(ops_sql "SELECT media_id, outcome FROM entry_report_uphold(:'report'::uuid, :'takedown', :'actor', :'note');" \
                 "report=$1" "takedown=$takedown" "actor=$OPERATOR" "note=$3")" || die "the database refused (see above)"
        [ "$out" != $'\tNOT_OPEN' ] || die "that id names no open report (never made, or already decided)"
        [ "$out" != $'\tRECLASSIFY_FIRST' ] ||
          die "a MINOR_SEXUAL_CONTENT report is never upheld by delete: block it (runbook §3, then §2), or, if the reporter's own detail shows the reason was wrong, reclassify it first"
        echo "Upheld."
        [ -n "$out" ] || { echo "It held nothing back: there was nothing to take down."; exit 0; }
        printf '%s\n' "$out" | while IFS=$'\t' read -r media outcome; do
          case "$outcome" in
            DELETED)         echo "  $media: deleted; its objects leave the storage within seconds, unless another open report holds it." ;;
            BLOCKED)         echo "  $media: blocked and held as evidence. Follow ops/moderation/takedown.md §2 now." ;;
            ALREADY_BLOCKED) echo "  $media: already blocked and held as evidence. Follow ops/moderation/takedown.md §2." ;;
            BLOCKED_KEPT)    echo "  $media: blocked, so kept as evidence, not deleted. Follow ops/moderation/takedown.md §2." ;;
            GONE|NOT_QUARANTINED) echo "  $media: already gone." ;;
            *)               echo "  $media: $outcome" ;;
          esac
        done
        ;;
      *) die "$usage" ;;
    esac
    ;;
  notifications)
    signed_in; BOND="$(bond)"
    if [ $# -eq 0 ]; then
      authed GET "/bonds/$BOND/members/me/notifications"; show 200
    else
      # The shape only, so the body is well formed: which kinds exist is the server's to say.
      for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z]+=(on|off)$ ]] || die "usage: moyi notifications [<kind>=on|off …], e.g. onThisDay=on"; done
      body="$(pairs "$@" | python3 -c '
import json, sys
a = sys.stdin.buffer.read().decode().split("\0")[:-1]
print(json.dumps({"categories": {k: v == "on" for k, v in (x.split("=") for x in a)}}))')"
      authed PUT "/bonds/$BOND/members/me/notifications" "$body"; show 200
    fi
    ;;
  edit)
    [ $# -eq 2 ] || die 'usage: moyi edit <entryId> "<text>"'
    need_uuid "$1" "$1"
    authed PATCH "/entries/$1" "$(json_of text "$2")"; show 200
    ;;
  delete)
    [ $# -eq 1 ] || die "usage: moyi delete <entryId>"
    need_uuid "$1" "$1"
    authed DELETE "/entries/$1"; show 204
    echo "Deleted."
    ;;
  help|-h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  media)
    # The operator's quarantine queue (spec §4 D4, ADR-0051): not a member's command, and the one
    # that talks to the database rather than the API. There is no admin console before Phase 5.
    [ "${1:-}" = quarantine ] || die "usage: moyi media quarantine list | release|delete|hold|block <mediaId> \"<note>\""
    shift
    action="${1:-}"; shift || true
    ops_init
    case "$action" in
      list)
        [ $# -eq 0 ] || die "usage: moyi media quarantine list"
        out="$(ops_sql "SELECT * FROM media_quarantine_list(:'actor');" "actor=$OPERATOR")" || die "the database refused (see above)"
        if [ -z "$out" ]; then echo "Nothing is held back."; exit 0; fi
        # The function's eight columns, in its order, verdict first: what may be looked at depends on it. A BLOCKED
        # row is child sexual abuse material, which is never viewed (ops/moderation/takedown.md §2), and says so. A row
        # an open member's report holds (reports > 0) is decided in the reports queue (runbook §3), not here.
        printf 'verdict\tmediaId\tkind\tstatus\treason\tattached\tmoderatedAt\treports\n'
        printf '%s\n' "$out" | awk -F '\t' 'BEGIN { OFS = "\t" }
          $1 == "BLOCKED" { print $0, "DO NOT VIEW — runbook §2"; next }
          $8 > 0 { print $0, "held by a report: moyi reports — runbook §3"; next }
          { print }'
        ;;
      hold|block)
        # A member's report (ops/moderation/takedown.md §3): hold a photo or voice note back from the partner, or
        # block it as child sexual abuse material (held as evidence, never released).
        [ $# -eq 2 ] || die "usage: moyi media quarantine $action <mediaId> \"<note>\""
        need_uuid mediaId "$1"
        [ -n "$2" ] && [ "${#2}" -le 500 ] || die "a note is required (at most 500 characters): the report, and when it came"
        result="$(ops_sql "SELECT media_quarantine_$action(:'media'::uuid, :'actor', :'note');" "media=$1" "actor=$OPERATOR" "note=$2")" ||
          die "the database refused (see above)"
        case "$result" in
          HELD)            echo "Held back: the partner is shown it as processing until you release or delete it." ;;
          BLOCKED)         echo "Blocked and held as evidence: never released. Follow ops/moderation/takedown.md §2 now." ;;
          ALREADY_BLOCKED) echo "Already blocked and held as evidence. Follow ops/moderation/takedown.md §2." ;;
          NOT_READY)       die "that id names nothing ready to hold back (already held back, never made, or deleted)" ;;
          GONE)            die "that id names nothing left to hold: never made, or deleted and its objects already purged" ;;
          *)               die "unexpected answer from the database: $result" ;;
        esac
        ;;
      release|delete)
        [ $# -eq 2 ] || die "usage: moyi media quarantine $action <mediaId> \"<note>\""
        need_uuid mediaId "$1"
        [ -n "$2" ] && [ "${#2}" -le 500 ] || die "a note is required (at most 500 characters): why, and for a deletion after a report, its reference"
        result="$(ops_sql "SELECT media_quarantine_$action(:'media'::uuid, :'actor', :'note');" "media=$1" "actor=$OPERATOR" "note=$2")" ||
          die "the database refused (see above)"
        case "$result" in
          RELEASED)        echo "Released: the partner is shown it from now on." ;;
          REMODERATED)     echo "Handed back to moderation: it was held before moderation saw it, so it is never passed unseen." ;;
          REPORT_HELD)     die "an open member's report holds it: decide the report (moyi reports list, then dismiss or uphold; runbook §3). The refusal is recorded." ;;
          DELETED)         echo "Deleted: its objects leave the storage within seconds (media.purge)." ;;
          NEVER_RELEASED)  die "it is blocked (child sexual abuse material): it is never released. The refusal is recorded. See ops/moderation/takedown.md." ;;
          NOT_QUARANTINED) die "that id names nothing held back" ;;
          *)               die "unexpected answer from the database: $result" ;;
        esac
        ;;
      *) die "usage: moyi media quarantine list | release|delete|hold|block <mediaId> \"<note>\"" ;;
    esac
    ;;
  *) die "unknown command: $cmd (try: moyi help)" ;;
esac
