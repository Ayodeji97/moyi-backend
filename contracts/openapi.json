          },
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 512,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "LoginResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          },
          "refreshToken" : {
            "type" : "string"
          },
          "user" : {
            "$ref" : "#/components/schemas/UserResponse"
          }
        }
      },
      "LogoutRequest" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "maxLength" : 256,
            "minLength" : 0
          }
        },
        "required" : [ "refreshToken" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "RFC 9457 problem details (doc 06 §2). Switch on `code`; `detail` is prose and may change.",
        "properties" : {
          "code" : {
            "type" : "string",
            "enum" : [ "MALFORMED_REQUEST", "VALIDATION_FAILED", "HASHING_CAPACITY_EXCEEDED", "VERIFICATION_TOKEN_INVALID", "VERIFICATION_TOKEN_EXPIRED", "INVALID_CREDENTIALS", "REFRESH_TOKEN_INVALID", "TOKEN_REUSE_DETECTED", "PASSWORD_RESET_TOKEN_INVALID", "PASSWORD_RESET_TOKEN_EXPIRED", "UNAUTHENTICATED", "FORBIDDEN", "RATE_LIMITED", "NOT_FOUND", "METHOD_NOT_ALLOWED", "UNSUPPORTED_MEDIA_TYPE", "INTERNAL_ERROR" ]
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldViolation"
            }
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        },
        "required" : [ "code", "status", "title", "type" ]
      },
      "RefreshRequest" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "maxLength" : 256,
            "minLength" : 0
          }
        },
        "required" : [ "refreshToken" ]
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "acceptedTermsVersion" : {
            "type" : "string",
            "maxLength" : 40,
            "minLength" : 0
          },
          "displayName" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "locale" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})?$"
          },
          "over18" : {
            "type" : "boolean"
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "acceptedTermsVersion", "displayName", "email", "locale", "password" ]
