# References only. Every value is read from Bitwarden at deploy time (the
# secure note `moyi-prod`, one hidden field per secret); nothing secret is
# ever written to this file, or to any file. Kamal asks for the master
# password once per command when the vault is locked.
#
# BITWARDEN_ACCOUNT is the vault's email address, set in your shell
# (export BITWARDEN_ACCOUNT=... in ~/.zshrc) so that it stays out of this
# public repository. Bitwarden's CLI must be logged in to the EU server:
#   bw config server https://vault.bitwarden.eu && bw login

SECRETS=$(kamal secrets fetch --adapter bitwarden --account $BITWARDEN_ACCOUNT --from moyi-prod POSTGRES_PASSWORD HASHING_SECRET JWT_PRIVATE_KEY_PEM JWT_PUBLIC_KEY_PEM RESEND_API_KEY GHCR_TOKEN R2_ENDPOINT MOYI_MEDIA_STORAGE_R2_ACCESS_KEY_ID MOYI_MEDIA_STORAGE_R2_SECRET_ACCESS_KEY)

# A GitHub token with read:packages only: the server's pull from GHCR.
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract GHCR_TOKEN $SECRETS)

# The Postgres accessory's password, and the app's (deploy.yml aliases it as
# SPRING_DATASOURCE_PASSWORD).
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD $SECRETS)

# The RS256 pair that signs access tokens (ADR-0019), each PEM on one line;
# SigningKeys strips whitespace between its BEGIN and END lines.
MOYI_SECURITY_JWT_PRIVATE_KEY_PEM=$(kamal secrets extract JWT_PRIVATE_KEY_PEM $SECRETS)
MOYI_SECURITY_JWT_PUBLIC_KEY_PEM=$(kamal secrets extract JWT_PUBLIC_KEY_PEM $SECRETS)

# The HMAC key behind ip_hash, the rate-limit keys and request hashes
# (ADR-0023). Never rotate it casually: retries of recorded idempotency keys
# turn into 422s for 24 hours.
MOYI_SECURITY_HASHING_SECRET=$(kamal secrets extract HASHING_SECRET $SECRETS)

# Resend key `moyi-prod`: sending access, getmoyi.app only.
MOYI_NOTIFICATION_EMAIL_RESEND_API_KEY=$(kamal secrets extract RESEND_API_KEY $SECRETS)

# Media storage (ADR-0047, ADR-0052): the R2 token `moyi-media-prod`, Object
# Read & Write on the `moyi-media` bucket only, and the account's EU endpoint.
# The endpoint is the field the backups already read (`R2_ENDPOINT`,
# ops/backup/README.md): one account, one jurisdiction, one value, kept in one
# place. It is a secret because it names the Cloudflare account. Both roles
# read all three: the API signs and checks, the worker reads and writes.
MOYI_MEDIA_STORAGE_R2_ENDPOINT=$(kamal secrets extract R2_ENDPOINT $SECRETS)
MOYI_MEDIA_STORAGE_R2_ACCESS_KEY_ID=$(kamal secrets extract MOYI_MEDIA_STORAGE_R2_ACCESS_KEY_ID $SECRETS)
MOYI_MEDIA_STORAGE_R2_SECRET_ACCESS_KEY=$(kamal secrets extract MOYI_MEDIA_STORAGE_R2_SECRET_ACCESS_KEY $SECRETS)
