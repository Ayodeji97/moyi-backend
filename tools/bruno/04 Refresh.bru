meta {
  name: Refresh
  type: http
  seq: 4
}

post {
  url: {{api}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  bru.setVar("accessToken", res.body.accessToken);
  bru.setVar("refreshToken", res.body.refreshToken);
}

docs {
  A refresh token works once. Presenting a used one signs every session of that family out, by design.
}
