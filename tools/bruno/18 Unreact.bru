meta {
  name: Unreact
  type: http
  seq: 18
}

delete {
  url: {{api}}/entries/{{partnerEntryId}}/reaction
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Takes your reaction back: 204, and 204 again if there was none. Allowed after the bond has ended, and on an entry that has since been deleted. An entry you were never shown is 404.

  409 REACTION_BUSY means something else is changing that reaction at this moment; send it again.
}
