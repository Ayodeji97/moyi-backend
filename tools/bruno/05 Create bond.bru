meta {
  name: Create bond
  type: http
  seq: 5
}

post {
  url: {{api}}/bonds
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Us",
    "type": "COUPLE",
    "anchorTimezone": "{{timezone}}"
  }
}

script:post-response {
  bru.setVar("bondId", res.body.id);
}

docs {
  The bond's timezone decides where a day begins and ends for both of you.
  The response carries the invite code (invite.code) to give your partner: read it off the response. You can write before they join.
}
