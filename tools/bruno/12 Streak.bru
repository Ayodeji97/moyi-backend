meta {
  name: Streak
  type: http
  seq: 12
}

get {
  url: {{api}}/bonds/{{bondId}}/streak
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  The run, the freezes, and a year of the calendar. A day is counted when it closes; today is added as soon as you have both written.
}
